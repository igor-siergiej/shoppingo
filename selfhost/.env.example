# Required. RustFS (S3-compatible object store) credentials used for the
# rustfs service, the bucket-init task, and the bucket the API reads/writes.
RUSTFS_ACCESS_KEY=rustfsadmin
RUSTFS_SECRET_KEY=rustfsadmin

# Optional. Defaults to "shoppingo". Used as the Mongo database name and
# as the RustFS bucket. The bucket-init container creates it on first run.
DATABASE_NAME=shoppingo
BUCKET_NAME=shoppingo

# Host port the web container publishes on. Maps to the web container's
# internal port 3000 (nginx). Set to e.g. 8080 if 4000 is taken.
WEB_PORT=4000

# Optional. A Fal.ai API key from https://fal.ai/dashboard/keys. Leave unset
# to disable the AI-backed features (recipe import via URL, substitute
# suggestions, AI image generation). Without it, those endpoints upstream
# 4xx from Fal.ai and the UI surfaces the error.
FAL_KEY=
FAL_MODEL=
FAL_RECIPE_MODEL=

# Wikibooks asks every consumer for a User-Agent. Override with your own
# contact so any abuse reports reach you rather than the project default.
WIKIBOOKS_USER_AGENT=Shoppingo/1.0 (https://github.com/igor-siergiej/shoppingo)

# Sign-in (Better Auth). Required. Generate the secret with `openssl rand -base64 32`; it must
# stay stable or every signed-in session is invalidated. `BETTER_AUTH_URL` is the public origin
# the browser sees for the web app (api is same-origin under /api).
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:4000

# Optional: enables Google sign-in (jott #146). Set both to enable; leave both empty to
# keep username/password only. Add `https://<your-host>/api/auth/callback/google` to your
# Google Cloud OAuth client's authorised redirect URIs.
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=

# Optional. Self-hosted Umami analytics (jott #72). Leave both blank to
# disable — the web app is a no-op tracker when the host/websiteId are
# empty, and CSP allowlists analytics.imapps.uk regardless. To use a
# different host, also update the CSP in packages/web/nginx.conf.
ANALYTICS_HOST=https://analytics.imapps.uk
ANALYTICS_WEBSITE_ID=
