PORT=4001
# Sign-in (Better Auth, served by the api at /api/auth). Required: the web app signs in through
# it. Dev value only; production uses `openssl rand -base64 32`. BETTER_AUTH_URL is the origin
# the browser sees.
BETTER_AUTH_SECRET=dev-better-auth-secret-not-for-prod-change-me
BETTER_AUTH_URL=http://localhost:4000
# Optional: enables Google sign-in (`@better-auth/mongo-adapter`).
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
FAL_KEY=your-fal-key-here
DATABASE_NAME=shoppingo
CONNECTION_URI=mongodb://devuser:devpassword@localhost:27017/shoppingo?authSource=admin
BUCKET_ENDPOINT=localhost:9000
BUCKET_NAME=shoppingo
BUCKET_ACCESS_KEY=rustfsadmin
BUCKET_SECRET_KEY=rustfsadmin

# Parse imported recipes LLM-first: hand the page's JSON-LD document to the model
# instead of running the three-tier scraper. Evaluation only: when true, a fal.ai
# outage makes every recipe import fail with a 502.
RECIPE_IMPORT_LLM_FIRST=false


# Recipe discovery search (OpenSearch). Optional: when unset, /api/discover/* answers 503 and
# the rest of the API is unaffected. Rebuild the index from Mongo with `bun run reindex:discovery`.
# OPENSEARCH_URL=http://localhost:9200

# Wikibooks Cookbook ingest (`bun run discover:ingest`). Optional: the default User-Agent names Shoppingo and a
# contact address, as Wikimedia's API etiquette asks. Override it if the operator contact changes.
# WIKIBOOKS_USER_AGENT=ShoppingoRecipeIngest/1.0 (https://shoppingo.imapps.uk; you@example.com)

# Moderation of public (user-published) recipes. Comma-separated user ids allowed to list reports and delist
# a recipe. Unset: nobody can delist.
# DISCOVERY_ADMIN_USER_IDS=user-id-1,user-id-2
